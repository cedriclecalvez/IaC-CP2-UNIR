[acr]
acr-server ansible_host={{ lookup('community.general.terraform', 'acr_name') }}

[vm]
vm-server ansible_host={{ lookup('community.general.terraform', 'vm_ip') }} ansible_user={{ lookup('community.general.terraform', 'vm_user') }} ansible_ssh_private_key_file=~/.ssh/id_rsa

[aks]
aks-server ansible_host={{ lookup('community.general.terraform', 'aks_kubeconfig') }}
